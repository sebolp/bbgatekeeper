// ====================== FAIL-OPEN GUARD ======================
// If bbgatekeeper_config.php is missing (e.g. right after a reset, or a partially
// completed deploy), let every request through unfiltered rather than
// fatal-erroring the whole site. acp/deploy_status_checker.php detects
// and reports this state independently from the ACP side.

// Never run twice in the same request (BBGATEKEEPER_LOG_DIR is defined
// below, right after the config is loaded).
if (defined('BBGATEKEEPER_LOG_DIR'))
{
	return;
}

$bbgatekeeper_config_path = __DIR__ . '/bbgatekeeper_config.php';
if (!is_readable($bbgatekeeper_config_path))
{
	return;
}

require $bbgatekeeper_config_path;
unset($bbgatekeeper_config_path);

// ====================== PATHS ======================

define('BBGATEKEEPER_LOG_DIR', __DIR__ . '/../logs');
define('BBGATEKEEPER_ACCESS_LOG', BBGATEKEEPER_LOG_DIR . '/access.log');
define('BBGATEKEEPER_BANS_DIR', BBGATEKEEPER_LOG_DIR . '/bans');
define('BBGATEKEEPER_MAX_LOG_SIZE', 20 * 1024 * 1024); // 20MB, then truncate

// ====================== UTILITY ======================

/**
* Verifies the visitor's verification cookie and, when it is valid but
* past half of its lifetime, renews it, so that active visitors are not
* sent back to the challenge once per cookie lifetime.
*/
function bbgatekeeper_check_verification_cookie(string $ip): bool
{
	$expires_at = 0;

	if (!bbgatekeeper_verify_hcap_token($_COOKIE[BBGATEKEEPER_HCAP_COOKIE_NAME] ?? null, $ip, $expires_at))
	{
		return false;
	}

	if (($expires_at - time()) < (BBGATEKEEPER_HCAP_COOKIE_TTL / 2) && !headers_sent())
	{
		bbgatekeeper_set_hcap_cookie($ip);
	}

	return true;
}

function bbgatekeeper_get_real_ip(): string
{
	$remote_addr = $_SERVER['REMOTE_ADDR'] ?? '';
	$xff = $_SERVER['HTTP_X_FORWARDED_FOR'] ?? '';

	// X-Forwarded-For is a plain, client-supplied header: it is only
	// honoured when Trusted Proxy is enabled in ACP AND REMOTE_ADDR
	// matches the configured proxy exactly. The rightmost entry is the
	// one appended by that proxy itself, so it cannot be forged by the
	// client. In every other case REMOTE_ADDR is used as is.
	if (
		defined('BBGATEKEEPER_TRUSTED_PROXY_ENABLE') && BBGATEKEEPER_TRUSTED_PROXY_ENABLE
		&& defined('BBGATEKEEPER_TRUSTED_PROXY_REMOTE_ADDR')
		&& BBGATEKEEPER_TRUSTED_PROXY_REMOTE_ADDR !== ''
		&& $remote_addr === BBGATEKEEPER_TRUSTED_PROXY_REMOTE_ADDR
		&& $xff !== ''
	)
	{
		$forwarded_ips = array_reverse(array_map('trim', explode(',', $xff)));

		foreach ($forwarded_ips as $candidate)
		{
			if (filter_var($candidate, FILTER_VALIDATE_IP))
			{
				return $candidate;
			}
		}
	}

	if (filter_var($remote_addr, FILTER_VALIDATE_IP))
	{
		return $remote_addr;
	}

	return '0.0.0.0';
}

function bbgatekeeper_ensure_log_dir(): void
{
	if (!is_dir(BBGATEKEEPER_LOG_DIR))
	{
		@mkdir(BBGATEKEEPER_LOG_DIR, 0750, true);
	}
}

function bbgatekeeper_write_log(string $line): void
{
	bbgatekeeper_ensure_log_dir();
	if (mt_rand(1, 500) === 1 && file_exists(BBGATEKEEPER_ACCESS_LOG) && filesize(BBGATEKEEPER_ACCESS_LOG) > BBGATEKEEPER_MAX_LOG_SIZE)
	{
		@file_put_contents(BBGATEKEEPER_ACCESS_LOG, '');
	}
	// Remove LOCK_EX to avoid PHP workers queuing up and causing 504 errors
	@file_put_contents(BBGATEKEEPER_ACCESS_LOG, $line, FILE_APPEND);
}

// ====================== RATE LIMITING AND BAN FUNCTION ======================

function bbgatekeeper_ensure_bans_dir(): void
{
	if (!is_dir(BBGATEKEEPER_BANS_DIR))
	{
		@mkdir(BBGATEKEEPER_BANS_DIR, 0750, true);
	}
}

function bbgatekeeper_is_ip_banned(string $ip): bool
{
	$ban_file = BBGATEKEEPER_BANS_DIR . '/' . md5($ip) . '.ban';

	// Check if the ban file exists
	if (file_exists($ban_file))
	{
		// Check if 30 minutes (1800 seconds) have passed
		if (filemtime($ban_file) > (time() - 1800))
		{
			return true;
		}
		else
		{
			// Time expired, remove the ban file
			@unlink($ban_file);
		}
	}

	return false;
}

function bbgatekeeper_record_block_and_check_ban(string $ip): void
{
	bbgatekeeper_ensure_bans_dir();

	$hit_file = BBGATEKEEPER_BANS_DIR . '/' . md5($ip) . '.hit';
	$now = time();
	$start_time = $now;
	$hits = 0;

	// Read existing hits for this IP
	if (file_exists($hit_file))
	{
		$data = @file_get_contents($hit_file);

		if ($data !== false)
		{
			// Format: "{start_time}|{hits}|{ip}" (the ip part is new;
			// older files without it still parse fine, ip stays empty).
			$parts = explode('|', $data);

			if (count($parts) >= 2)
			{
				$start_time = (int)$parts[0];
				$hits = (int)$parts[1];
			}
		}
	}

	// Reset counter if more than 60 seconds have passed
	if (($now - $start_time) > 60)
	{
		$start_time = $now;
		$hits = 0;
	}

	$hits++;

	// #################################
	// #################################
	// If the IP hits 2 times (fails two times hCaptcha
	// within the 60 seconds window, trigger the ban
	if ($hits >= 2)
	{
		$ban_file = BBGATEKEEPER_BANS_DIR . '/' . md5($ip) . '.ban';
		// Store the ip (and ban time) in clear text so the ACP
		// Hits & Bans view can display it without reversing the hash.
		@file_put_contents($ban_file, $ip . '|' . $now);
		@unlink($hit_file);
	}
	else
	{
		// Update the hit counter, now including the ip for ACP display
		@file_put_contents($hit_file, $start_time . '|' . $hits . '|' . $ip);
	}
}

// ====================== STEP 1: USER-AGENT ======================

function bbgatekeeper_check_user_agent_block(array $patterns): ?string
{
	$ua = strtolower($_SERVER['HTTP_USER_AGENT'] ?? '');
	if ($ua === '')
	{
		return 'empty-ua';
	}
	foreach ($patterns as $pattern)
	{
		if (strpos($ua, $pattern) !== false)
		{
			return 'ua:' . $pattern;
		}
	}
	return null;
}

// ====================== EXECUTION ======================

/**
* Runs the whole gatekeeper request cycle. Kept in a function so that none
* of its variables ends up in the global scope of the host application.
*/
function bbgatekeeper_run(): void
{
	$ip = bbgatekeeper_get_real_ip();

	// Immediately reject banned IPs without rendering anything
	if (bbgatekeeper_is_ip_banned($ip))
	{
		http_response_code(429);
		header('Retry-After: 1800');
		exit;
	}

	$uri = $_SERVER['REQUEST_URI'] ?? '-';
	$ua_raw = $_SERVER['HTTP_USER_AGENT'] ?? '-';
	$now_str = date('Y-m-d H:i:s');

	// Path of the PHP script actually being executed. Used for the excluded
	// paths list instead of REQUEST_URI, so it cannot be bypassed by
	// appending extra path info or a query string to a protected URL.
	$script_path = (string) ($_SERVER['SCRIPT_NAME'] ?? '');

	$reason = bbgatekeeper_check_user_agent_block(BBGATEKEEPER_BLOCKED_UA_PATTERNS);

	// ====================== STEP 2: CAPTCHA VALIDATION ======================
	// Provider-specific bits (endpoint, POST field name, widget markup) come
	// from CAPTCHA_* constants in bbgatekeeper_config.php, resolved once at
	// deploy time by core/config_exporter.php from the ACP provider tab.

	$hc_challenge_failed = false;
	$is_bot_whitelist = false;
	$captcha_rejected = false;

	if ($reason === null)
	{
		$bypass_challenge = false;

		// No static asset exemption on purpose: genuine static files are
		// served by the web server without ever invoking PHP, so every
		// request reaching this script is dynamic.

		if (!$bypass_challenge && defined('BBGATEKEEPER_EXCLUDED_PATHS') && !empty(BBGATEKEEPER_EXCLUDED_PATHS))
		{
			foreach (BBGATEKEEPER_EXCLUDED_PATHS as $excluded_path)
			{
				if ($excluded_path !== '' && strpos($script_path, $excluded_path) !== false)
				{
					$bypass_challenge = true;
					break;
				}
			}
		}

		if (!$bypass_challenge && !bbgatekeeper_check_verification_cookie($ip))
		{
			// The FCrDNS whitelist check does a blocking reverse+forward DNS
			// lookup, so it only runs here - once we already know a
			// challenge would otherwise be shown - instead of on every
			// single request regardless of cookie state.
			$is_bot_whitelist = bbgatekeeper_is_search_engine_bot($ip);

			if (!$is_bot_whitelist)
			{
				$reason = 'captcha-required';
				$hc_challenge_failed = true;
			}
		}
	}

	if ($hc_challenge_failed && $_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST[BBGATEKEEPER_CAPTCHA_RESPONSE_FIELD]))
	{
		$verify_url = BBGATEKEEPER_CAPTCHA_VERIFY_URL;

		$context = stream_context_create([
			'http' => [
				'method'  => 'POST',
				'header'  => "Content-Type: application/x-www-form-urlencoded\r\n",
				'content' => http_build_query([
					'secret'   => BBGATEKEEPER_CAPTCHA_SITE_SECRET,
					'response' => $_POST[BBGATEKEEPER_CAPTCHA_RESPONSE_FIELD],
				]),
				'timeout' => 5,
			],
		]);

		$response = @file_get_contents($verify_url, false, $context);

		if ($response !== false)
		{
			$data = json_decode($response);
			if ($data && isset($data->success) && $data->success)
			{
				// write log file
				$debug_bound = bbgatekeeper_get_ip_binding_value($ip, BBGATEKEEPER_IP_BINDING_LEVEL);
				$debug_remote_addr = $_SERVER['REMOTE_ADDR'] ?? '-';
				$debug_xff = $_SERVER['HTTP_X_FORWARDED_FOR'] ?? '-';
				bbgatekeeper_write_log("{$now_str}|{$ip}|🍪 cookie set|bound={$debug_bound}|remote_addr={$debug_remote_addr}|xff={$debug_xff}\n");

				bbgatekeeper_set_hcap_cookie($ip);
				header('Location: ' . $_SERVER['REQUEST_URI']);
				exit;
			}

			// The provider answered but did not accept the token: this is
			// the only case that counts as a hit toward a ban.
			$captcha_rejected = true;
		}
	}

	// ====================== LOGGING ======================

	if ($reason === 'captcha-required')
	{
		$status = '🚫: ' . BBGATEKEEPER_CAPTCHA_PROVIDER;
		// write log file
		$debug_bound = bbgatekeeper_get_ip_binding_value($ip, BBGATEKEEPER_IP_BINDING_LEVEL);
		$debug_remote_addr = $_SERVER['REMOTE_ADDR'] ?? '-';
		$debug_xff = $_SERVER['HTTP_X_FORWARDED_FOR'] ?? '-';
		bbgatekeeper_write_log("{$now_str}|{$ip}|❌ verify failed|bound={$debug_bound}|remote_addr={$debug_remote_addr}|xff={$debug_xff}|has_cookie=" . (isset($_COOKIE[BBGATEKEEPER_HCAP_COOKIE_NAME]) ? 'yes' : 'no') . "\n");
	}
	else if ($reason !== null)
	{
		$status = '🚫:' . $reason;
	}
	else
	{
		$status = '✅';
	}
	// Write only if enabled
	if (!defined('BBGATEKEEPER_ENABLE_ACCESS_LOG') || BBGATEKEEPER_ENABLE_ACCESS_LOG)
	{
		bbgatekeeper_write_log("{$now_str}|{$ip}|{$status}|{$uri}|{$ua_raw}\n");
	}

	// ====================== ENFORCEMENT ======================

	if ($reason !== null && !BBGATEKEEPER_DRY_RUN)
	{
		// A plain POST without a valid cookie (e.g. a form submitted after
		// the cookie expired) is NOT a violation. Only a captcha token that
		// was actually submitted and rejected is recorded, to evaluate a
		// temporary 30-minutes ban.
		if ($captcha_rejected)
		{
			bbgatekeeper_record_block_and_check_ban($ip);
		}

			if ($hc_challenge_failed)
		{
			// Resolved once here (not baked in at deploy time like the old
			// hCaptcha-only version), so the heredoc below stays provider-
			// agnostic and just interpolates these.
			$captcha_script_src = BBGATEKEEPER_CAPTCHA_WIDGET_SCRIPT_SRC;
			$captcha_widget_class = BBGATEKEEPER_CAPTCHA_WIDGET_CLASS;
			$captcha_site_key = BBGATEKEEPER_CAPTCHA_SITE_KEY;
			$captcha_response_field = BBGATEKEEPER_CAPTCHA_RESPONSE_FIELD;
			$captcha_provider_js = BBGATEKEEPER_CAPTCHA_PROVIDER;

			// Autologin (invisible challenge): Turnstile auto-runs once
			// rendered with this attribute; hCaptcha instead needs an
			// explicit hcaptcha.execute() call below, and its site key must
			// be set to "invisible" in the hCaptcha dashboard (see ACP
			// explanation text) or the widget will never fire on its own.
			$autologin_enabled = defined('BBGATEKEEPER_AUTOLOGIN_ENABLE') && BBGATEKEEPER_AUTOLOGIN_ENABLE;
			$autologin_widget_attr = ($autologin_enabled && $captcha_provider_js === 'turnstile') ? ' data-appearance="interaction-only"' : '';
			$autologin_button_style = $autologin_enabled ? ' style="display:none;"' : '';
			$autologin_js_flag = $autologin_enabled ? 'true' : 'false';

