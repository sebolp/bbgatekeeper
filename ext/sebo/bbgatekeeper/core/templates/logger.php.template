							var response = document.querySelector('[name="{$captcha_response_field}"]');
							if (!response || response.value.trim() === '') {
								alert('{{BB_LOGGER_TEMPLATE_ERROR_CHALLENGE_NOT_COMPLETED}}');
								return false;
							}
							// prevent double click
							document.getElementById('submitBtn').disabled = true;
							return true;
						}
						function showEmail(event) {
							event.preventDefault();
							var user = "{{BB_LOGGER_TEMPLATE_EMAIL_NAME}}";
							var domain = "{{BB_LOGGER_TEMPLATE_EMAIL_DOMAIN}}";
							var area = document.getElementById('email-area');
							area.innerHTML = '<a href="mailto:' + user + '@' + domain + '">' + user + '@' + domain + '</a>';
						}
						window.addEventListener('load', function () {
							if (window.bbgkAutologin && '{$captcha_provider_js}' === 'hcaptcha' && typeof hcaptcha !== 'undefined') {
								hcaptcha.execute();
							}
						});
					</script>
				</body>
				</html>
				HTML;
			exit;
		}
		else
		{
			http_response_code(429);
			header('Retry-After: 30');
			exit('{{BB_LOGGER_TEMPLATE_ERROR_TOO_MANY_REQUESTS}}');
		}
	}
}

bbgatekeeper_run();
